{
  "name": "@thiepn/recipe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/site-smoke.test.mjs",
    "verify": "pnpm typecheck && pnpm test && node --test tests/site-smoke.test.mjs && pnpm build && pnpm smoke:local",
    "smoke:site": "node scripts/check-site.mjs",
    "smoke:local": "node scripts/check-local.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "zod": "4.6.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "fake-indexeddb": "6.2.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "@playwright/test": "1.56.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
